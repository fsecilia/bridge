cmake_minimum_required(VERSION 3.31.6)

if(NOT DEFINED BRIDGE_DISTRIBUTION_RECIPE OR NOT EXISTS "${BRIDGE_DISTRIBUTION_RECIPE}")
    message(FATAL_ERROR "Bridge distribution collection recipe is missing")
endif()
include("${BRIDGE_DISTRIBUTION_RECIPE}")
file(REAL_PATH "${BRIDGE_DISTRIBUTION_COORDINATOR_DIRECTORY}" _coordinator)
file(REAL_PATH "${BRIDGE_DISTRIBUTION_EXPECTED_SOURCE}" _source)
# An interrupted or failed collection must not leave a previous manifest
# claiming that the currently requested release set was produced.
file(REMOVE "${BRIDGE_DISTRIBUTION_COLLECTION_DIRECTORY}/manifest.json")

# Build all requested producers before publishing any outputs. A workflow producer
# runs its complete workflow preset (on the host or through its launcher), while
# ordinary producers reuse their already configured build trees. Both paths verify
# source identity afterward.
set(_manifests "")
set(_producers "")
foreach(_entry IN LISTS BRIDGE_DISTRIBUTION_BUILD_TREES)
    if(NOT "${_entry}" MATCHES "^(.+)\\|([A-Za-z0-9_-]+)$")
        message(FATAL_ERROR "Invalid distribution build-tree entry: '${_entry}'")
    endif()
    list(APPEND _producers "configured|${CMAKE_MATCH_1}|${CMAKE_MATCH_2}")
endforeach()
foreach(_entry IN LISTS BRIDGE_DISTRIBUTION_WORKFLOW_BUILD_TREES)
    if(NOT "${_entry}" MATCHES "^([^|]+)\\|([A-Za-z0-9_-]+)(\\|([^|]+))?$")
        message(FATAL_ERROR "Invalid distribution workflow entry: '${_entry}'\n"
            "Expected <build directory>|<workflow preset>[|<command launcher>]")
    endif()
    list(APPEND _producers "workflow|${CMAKE_MATCH_1}|${CMAKE_MATCH_2}|${CMAKE_MATCH_4}")
endforeach()

foreach(_producer IN LISTS _producers)
    string(REPLACE "|" ";" _parts "${_producer}")
    list(GET _parts 0 _mode)
    list(GET _parts 1 _build_dir)
    if(EXISTS "${_build_dir}")
        file(REAL_PATH "${_build_dir}" _build_dir)
    endif()
    if("${_build_dir}" STREQUAL "${_coordinator}")
        message(FATAL_ERROR "A distribution coordinator cannot recursively build its own active tree: ${_build_dir}")
    endif()
    if(_mode STREQUAL "workflow")
        # The workflow configures, builds, tests, and packages in one invocation; its
        # final step must build the producer's distribution target. A manifest left by
        # an earlier run must not stand in for one this workflow failed to write.
        list(GET _parts 2 _preset)
        list(GET _parts 3 _launcher)
        file(REMOVE "${_build_dir}/dist/manifest.json")
        if(_launcher STREQUAL "")
            set(_workflow_command "${CMAKE_COMMAND}")
            message(STATUS "Running distribution workflow ${_preset}")
        else()
            if(NOT IS_ABSOLUTE "${_launcher}" OR NOT EXISTS "${_launcher}")
                message(FATAL_ERROR "Distribution workflow launcher is unavailable: ${_launcher}")
            endif()
            # The launched environment supplies its own CMake.
            set(_workflow_command "${_launcher}" cmake)
            message(STATUS "Running distribution workflow ${_preset} through ${_launcher}")
        endif()
        execute_process(
            COMMAND ${_workflow_command} --workflow --preset "${_preset}"
            WORKING_DIRECTORY "${_source}"
            RESULT_VARIABLE _result
            COMMAND_ECHO STDOUT
        )
        if(NOT "${_result}" STREQUAL "0")
            message(FATAL_ERROR "Distribution workflow failed (${_result}): ${_preset} in ${_source}")
        endif()
    else()
        list(GET _parts 2 _target)
    endif()
    if(NOT EXISTS "${_build_dir}/CMakeCache.txt")
        message(FATAL_ERROR "Requested distribution build tree is not configured: ${_build_dir}\nConfigure it with the matching project preset first.")
    endif()
    file(REAL_PATH "${_build_dir}" _build_dir)
    file(STRINGS "${_build_dir}/CMakeCache.txt" _cache_source REGEX "^CMAKE_HOME_DIRECTORY:INTERNAL=")
    if(NOT _cache_source)
        message(FATAL_ERROR "Distribution build tree has no CMake source identity: ${_build_dir}")
    endif()
    string(REGEX REPLACE "^CMAKE_HOME_DIRECTORY:INTERNAL=" "" _cache_source "${_cache_source}")
    file(REAL_PATH "${_cache_source}" _cache_source)
    if(NOT "${_cache_source}" STREQUAL "${_source}")
        message(FATAL_ERROR "Distribution build tree uses a different source: ${_build_dir}\nExpected: ${_source}\nActual: ${_cache_source}")
    endif()
    if(_mode STREQUAL "configured")
        set(_config_args "")
        if(DEFINED BRIDGE_DISTRIBUTION_CONFIG AND NOT "${BRIDGE_DISTRIBUTION_CONFIG}" STREQUAL "")
            list(APPEND _config_args --config "${BRIDGE_DISTRIBUTION_CONFIG}")
        endif()
        message(STATUS "Building distribution target ${_target} in ${_build_dir}")
        execute_process(
            COMMAND "${CMAKE_COMMAND}" --build "${_build_dir}" --target "${_target}" ${_config_args}
            RESULT_VARIABLE _result
            COMMAND_ECHO STDOUT
        )
        if(NOT "${_result}" STREQUAL "0")
            message(FATAL_ERROR "Distribution build failed (${_result}): ${_build_dir} target ${_target}")
        endif()
    endif()
    set(_manifest "${_build_dir}/dist/manifest.json")
    if(NOT EXISTS "${_manifest}")
        if(_mode STREQUAL "workflow")
            message(FATAL_ERROR "Distribution workflow ${_preset} did not produce its manifest: ${_manifest}\n"
                "The workflow's final step must build the distribution target.")
        endif()
        message(FATAL_ERROR "Distribution build did not produce its manifest: ${_manifest}")
    endif()
    list(APPEND _manifests "${_manifest}")
endforeach()

set(_published "{\n  \"schema_version\": 1,\n  \"artifacts\": [\n")
set(_separator "")
set(_paths "")
foreach(_manifest IN LISTS _manifests)
    file(READ "${_manifest}" _data)
    string(JSON _schema GET "${_data}" schema_version)
    if(NOT "${_schema}" STREQUAL "1")
        message(FATAL_ERROR "Unsupported distribution manifest schema in ${_manifest}: ${_schema}")
    endif()
    string(JSON _count LENGTH "${_data}" artifacts)
    if(_count LESS 1)
        message(FATAL_ERROR "Distribution manifest is empty: ${_manifest}")
    endif()
    math(EXPR _last "${_count} - 1")
    foreach(_index RANGE 0 ${_last})
        foreach(_field IN ITEMS type platform version path sha256 validation)
            string(JSON _${_field} GET "${_data}" artifacts ${_index} ${_field})
        endforeach()
        string(LENGTH "${_sha256}" _hash_length)
        if(NOT "${_type}" MATCHES "^[a-z0-9-]+$" OR
           NOT "${_platform}" MATCHES "^[a-z0-9-]+$" OR
           NOT "${_version}" MATCHES "^[0-9A-Za-z.+-]+$" OR
           NOT "${_path}" MATCHES "^[A-Za-z0-9_.+-]+$" OR
           NOT "${_sha256}" MATCHES "^[a-f0-9]+$" OR NOT _hash_length EQUAL 64 OR
           NOT "${_validation}" STREQUAL "not_run")
            message(FATAL_ERROR "Invalid distribution manifest entry in ${_manifest}")
        endif()
        set(_relative "${_platform}/${_path}")
        if(_relative IN_LIST _paths)
            message(FATAL_ERROR "Duplicate collected distribution path: ${_relative}")
        endif()
        list(APPEND _paths "${_relative}")
        get_filename_component(_origin "${_manifest}" DIRECTORY)
        set(_input "${_origin}/${_path}")
        if(NOT EXISTS "${_input}")
            message(FATAL_ERROR "Manifest references a missing artifact: ${_input}")
        endif()
        file(SHA256 "${_input}" _actual_hash)
        if(NOT "${_actual_hash}" STREQUAL "${_sha256}")
            message(FATAL_ERROR "Distribution artifact checksum mismatch: ${_input}")
        endif()
        string(APPEND _published "${_separator}    {\"type\": \"${_type}\", \"platform\": \"${_platform}\", \"version\": \"${_version}\", \"path\": \"${_relative}\", \"sha256\": \"${_sha256}\", \"validation\": \"${_validation}\"}")
        set(_separator ",\n")
    endforeach()
endforeach()
string(APPEND _published "\n  ]\n}\n")

# Publish only after every tree and source artifact has passed verification.
foreach(_manifest IN LISTS _manifests)
    file(READ "${_manifest}" _data)
    string(JSON _count LENGTH "${_data}" artifacts)
    math(EXPR _last "${_count} - 1")
    foreach(_index RANGE 0 ${_last})
        string(JSON _platform GET "${_data}" artifacts ${_index} platform)
        string(JSON _path GET "${_data}" artifacts ${_index} path)
        file(MAKE_DIRECTORY "${BRIDGE_DISTRIBUTION_COLLECTION_DIRECTORY}/${_platform}")
        get_filename_component(_origin "${_manifest}" DIRECTORY)
        file(COPY_FILE "${_origin}/${_path}" "${BRIDGE_DISTRIBUTION_COLLECTION_DIRECTORY}/${_platform}/${_path}" ONLY_IF_DIFFERENT)
    endforeach()
endforeach()
# A validator receives a provisional manifest and returns per-artifact results.
# It cannot edit the authoritative manifest; the collector verifies and publishes
# the results only after the entire requested validation succeeds.
if(DEFINED BRIDGE_DISTRIBUTION_VALIDATOR AND NOT "${BRIDGE_DISTRIBUTION_VALIDATOR}" STREQUAL "")
    set(_candidate "${BRIDGE_DISTRIBUTION_COLLECTION_DIRECTORY}/manifest-candidate.json")
    set(_report "${BRIDGE_DISTRIBUTION_COLLECTION_DIRECTORY}/validation-report.json")
    file(REMOVE "${_report}")
    file(WRITE "${_candidate}" "${_published}")
    execute_process(
        COMMAND "${BRIDGE_DISTRIBUTION_VALIDATOR}" --manifest "${_candidate}" --report "${_report}"
            ${BRIDGE_DISTRIBUTION_VALIDATION_ARGS}
        RESULT_VARIABLE _result
        COMMAND_ECHO STDOUT
    )
    if(NOT "${_result}" STREQUAL "0" OR NOT EXISTS "${_report}")
        message(FATAL_ERROR "Distribution validation failed (${_result}); manifest was not published")
    endif()
    file(READ "${_report}" _validation_report)
    string(JSON _report_schema ERROR_VARIABLE _json_error GET "${_validation_report}" schema_version)
    if(_json_error OR NOT "${_report_schema}" STREQUAL "1")
        message(FATAL_ERROR "Invalid distribution validation report: ${_report}")
    endif()
    string(JSON _reported_count LENGTH "${_validation_report}" artifacts)
    list(LENGTH _paths _expected_count)
    if(NOT _reported_count EQUAL _expected_count)
        message(FATAL_ERROR "Validator reported ${_reported_count} artifacts, expected ${_expected_count}")
    endif()
    set(_index 0)
    foreach(_path IN LISTS _paths)
        string(JSON _details ERROR_VARIABLE _json_error GET "${_validation_report}" artifacts "${_path}")
        if(_json_error)
            message(FATAL_ERROR "Missing validation for ${_path}: ${_json_error}")
        endif()
        string(JSON _type TYPE "${_validation_report}" artifacts "${_path}")
        if(NOT _type STREQUAL "OBJECT")
            message(FATAL_ERROR "Invalid validation object for ${_path}")
        endif()
        string(JSON _checks LENGTH "${_details}")
        if(_checks LESS 1)
            message(FATAL_ERROR "Empty validation result for ${_path}")
        endif()
        math(EXPR _last_check "${_checks} - 1")
        foreach(_check_index RANGE 0 ${_last_check})
            string(JSON _check MEMBER "${_details}" ${_check_index})
            string(JSON _status GET "${_details}" "${_check}")
            if(NOT "${_check}" MATCHES "^[a-z][a-z0-9_]*$" OR
               NOT "${_status}" MATCHES "^(passed|not_run)$")
                message(FATAL_ERROR "Invalid validation state for ${_path}: ${_check}=${_status}")
            endif()
        endforeach()
        string(JSON _published SET "${_published}" artifacts ${_index} validation "${_details}")
        math(EXPR _index "${_index} + 1")
    endforeach()
    string(JSON _published SET "${_published}" schema_version 2)
    file(REMOVE "${_candidate}")
endif()
file(WRITE "${BRIDGE_DISTRIBUTION_COLLECTION_DIRECTORY}/manifest.json" "${_published}")
