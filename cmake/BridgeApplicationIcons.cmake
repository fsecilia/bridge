set(BRIDGE_LINUX_DESKTOP_INTEGRATION install CACHE STRING
    "Linux desktop entry and hicolor icons: install or none")
set_property(CACHE BRIDGE_LINUX_DESKTOP_INTEGRATION PROPERTY STRINGS install none)

# Windows embeds the original PNG bytes as RT_ICON resources. CMake checks their headers, but cannot verify PNG
# checksums or decompress pixel data. Android and Linux retain full PNG validation through the Python packaging tool.
function(_bridge_check_png_header PATH EXPECTED_SIZE)
    if(NOT EXISTS "${PATH}")
        message(FATAL_ERROR "Bridge icon is missing: ${PATH}")
    endif()
    file(SIZE "${PATH}" _file_size)
    if(_file_size LESS 45)
        message(FATAL_ERROR "Bridge icon is too small to be a complete PNG: ${PATH}")
    endif()
    file(READ "${PATH}" _header LIMIT 29 HEX)
    if(NOT _header MATCHES "^89504e470d0a1a0a0000000d49484452")
        message(FATAL_ERROR "Bridge icon does not start with a PNG IHDR: ${PATH}")
    endif()
    string(SUBSTRING "${_header}" 32 8 _width_hex)
    string(SUBSTRING "${_header}" 40 8 _height_hex)
    string(SUBSTRING "${_header}" 48 2 _depth)
    string(SUBSTRING "${_header}" 50 2 _color)
    math(EXPR _width "0x${_width_hex}")
    math(EXPR _height "0x${_height_hex}")
    if(NOT _width EQUAL EXPECTED_SIZE OR NOT _height EQUAL EXPECTED_SIZE)
        message(FATAL_ERROR "Bridge icon ${PATH}: expected ${EXPECTED_SIZE}x${EXPECTED_SIZE}, got ${_width}x${_height}")
    endif()
    if(NOT _depth STREQUAL "08" OR NOT _color MATCHES "^(02|06)$")
        message(FATAL_ERROR "Bridge icon ${PATH}: expected 8-bit RGB or RGBA PNG")
    endif()
    string(SUBSTRING "${_header}" 52 6 _png_modes)
    if(NOT _png_modes STREQUAL "000000")
        message(FATAL_ERROR "Bridge icon ${PATH}: expected non-interlaced PNG with standard compression and filtering")
    endif()
    math(EXPR _footer_offset "${_file_size} - 12")
    file(READ "${PATH}" _footer OFFSET ${_footer_offset} LIMIT 12 HEX)
    if(NOT _footer STREQUAL "0000000049454e44ae426082")
        message(FATAL_ERROR "Bridge icon ${PATH}: missing final PNG IEND chunk")
    endif()
endfunction()

# Shared by Android, Windows, and Linux packaging. ICON_DIRECTORY points to one consumer-rendered tree with
# opaque/, transparent/, adaptive/, and monochrome/ families. Bridge validates and packages the images without resizing.
function(_bridge_validate_icon_directory DIRECTORY OUT_DIRECTORY OUT_PYTHON OUT_DEPENDENCIES)
    # The icon contract shared with bridge_icons.py. Add supported sizes here when the icon format changes.
    set(_bridge_icon_standalone_sizes 16 24 32 48 64 72 96 128 144 192 256 512)
    set(_bridge_icon_adaptive_sizes 108 162 216 324 432)

    set(_directory "${DIRECTORY}")
    cmake_path(ABSOLUTE_PATH _directory BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" NORMALIZE)
    if(NOT IS_DIRECTORY "${_directory}")
        message(FATAL_ERROR "Bridge icon directory does not exist: ${_directory}")
    endif()
    set(_dependencies)
    foreach(_size IN LISTS _bridge_icon_standalone_sizes)
        list(APPEND _dependencies "${_directory}/opaque/${_size}.png" "${_directory}/transparent/${_size}.png")
    endforeach()
    foreach(_size IN LISTS _bridge_icon_adaptive_sizes)
        list(APPEND _dependencies "${_directory}/adaptive/${_size}.png" "${_directory}/monochrome/${_size}.png")
    endforeach()

    if(WIN32)
        foreach(_file IN LISTS _dependencies)
            get_filename_component(_name "${_file}" NAME_WE)
            _bridge_check_png_header("${_file}" "${_name}")
        endforeach()
        message(STATUS "Bridge Windows icon validation checks PNG headers only (checksums and pixel data are not checked)")
        set(_python "")
    else()
        find_package(Python3 REQUIRED COMPONENTS Interpreter)
        set(_script "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../scripts/bridge_icons.py")
        execute_process(
            COMMAND "${Python3_EXECUTABLE}" "${_script}" validate --source "${_directory}"
            RESULT_VARIABLE _result
            OUTPUT_VARIABLE _stdout
            ERROR_VARIABLE _stderr
        )
        if(NOT _result EQUAL 0)
            message(FATAL_ERROR "Bridge icon validation failed:\n${_stdout}${_stderr}")
        endif()
        set(_python "${Python3_EXECUTABLE}")
    endif()
    set(${OUT_DIRECTORY} "${_directory}" PARENT_SCOPE)
    set(${OUT_PYTHON} "${_python}" PARENT_SCOPE)
    set(${OUT_DEPENDENCIES} "${_dependencies}" PARENT_SCOPE)
endfunction()

# Type 3 is RT_ICON; type 14 is RT_GROUP_ICON. The group header is three WORDs;
# each entry has two packed dimension bytes, two zero bytes, planes, bit depth, a DWORD byte length, and an icon ID.
function(_bridge_write_png_icon_resources DIRECTORY RC_FILE OUT_PNGS)
    set(_ico_sizes 16 24 32 48 64 256)
    set(_pngs)
    set(_images "")
    set(_group "1 14 BEGIN\n    0, 1, 6,\n")
    set(_id 0)
    foreach(_size IN LISTS _ico_sizes)
        math(EXPR _id "${_id} + 1")
        set(_png "${DIRECTORY}/transparent/${_size}.png")
        file(SIZE "${_png}" _bytes)
        if(_size EQUAL 256)
            set(_encoded_size 0)
        else()
            set(_encoded_size "${_size}")
        endif()
        math(EXPR _packed_size "${_encoded_size} | (${_encoded_size} << 8)")
        string(APPEND _images "${_id} 3 \"${_png}\"\n")
        if(_id EQUAL 6)
            set(_entry_terminator "")
        else()
            set(_entry_terminator ",")
        endif()
        string(APPEND _group "    ${_packed_size}, 0, 1, 32, ${_bytes}L, ${_id}${_entry_terminator}\n")
        list(APPEND _pngs "${_png}")
    endforeach()
    string(APPEND _group "END\n")
    file(WRITE "${RC_FILE}" "${_images}${_group}")
    set(${OUT_PNGS} "${_pngs}" PARENT_SCOPE)
endfunction()

# Embed Windows application icons assembled from transparent/ PNGs into an existing consumer-owned executable.
# This public entry point is a macro so it can enable RC in the caller's directory if needed.
# When invoked inside a function without RC already enabled, report an error instead of configuring the wrong scope.
macro(bridge_embed_win32_application_icon)
    if(NOT WIN32)
        message(FATAL_ERROR "bridge_embed_win32_application_icon() requires Windows")
    endif()
    if(NOT CMAKE_RC_COMPILER_LOADED)
        if(CMAKE_CURRENT_FUNCTION)
            message(
                FATAL_ERROR
                "bridge_embed_win32_application_icon(): RC is not enabled, and it cannot be enabled from inside "
                "${CMAKE_CURRENT_FUNCTION}(). Call enable_language(RC) in the directory that defines the "
                "executable, or in a parent directory, before calling ${CMAKE_CURRENT_FUNCTION}()."
            )
        endif()
        enable_language(RC)
    endif()
    _bridge_embed_win32_application_icon(${ARGN})
endmacro()

function(_bridge_embed_win32_application_icon)
    cmake_parse_arguments(PARSE_ARGV 0 ARG "" "TARGET;ICON_DIRECTORY" "")
    if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "bridge_embed_win32_application_icon(): invalid arguments")
    endif()
    if(NOT WIN32)
        message(FATAL_ERROR "bridge_embed_win32_application_icon() requires Windows")
    endif()
    if(NOT TARGET "${ARG_TARGET}" OR NOT ARG_ICON_DIRECTORY)
        message(FATAL_ERROR "bridge_embed_win32_application_icon(): TARGET and ICON_DIRECTORY are required")
    endif()
    get_target_property(_type "${ARG_TARGET}" TYPE)
    if(NOT _type STREQUAL "EXECUTABLE")
        message(FATAL_ERROR "bridge_embed_win32_application_icon(): '${ARG_TARGET}' must be an executable")
    endif()
    _bridge_validate_icon_directory("${ARG_ICON_DIRECTORY}" _directory _python _dependencies)

    set(_generated "${CMAKE_CURRENT_BINARY_DIR}/bridge-icons/${ARG_TARGET}")
    set(_rc "${_generated}/application.rc")
    file(MAKE_DIRECTORY "${_generated}")
    _bridge_write_png_icon_resources("${_directory}" "${_rc}" _pngs)
    # The resource group records each PNG's byte length. A changed PNG must update both the group and its raw resource.
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${_pngs})
    set_source_files_properties("${_rc}" PROPERTIES OBJECT_DEPENDS "${_pngs}")
    target_sources("${ARG_TARGET}" PRIVATE "${_rc}")
endfunction()

# Install a Linux application and its explicit dependencies. Runtime icons are always installed beside the
# executable; DESKTOP_INTEGRATION install|none (default BRIDGE_LINUX_DESKTOP_INTEGRATION) selects whether to install
# the freedesktop .desktop entry and hicolor icons as well. COMPONENT places every rule in that install component, so
# a package can select exactly the application instead of every install rule in the project.
function(bridge_install_linux_desktop_application)
    cmake_parse_arguments(PARSE_ARGV 0 ARG "" "TARGET;APPLICATION_ID;APPLICATION_NAME;ICON_DIRECTORY;ASSET_DIRECTORY;CATEGORIES;DESKTOP_INTEGRATION;COMPONENT" "RUNTIME_TARGETS;SYSTEM_RUNTIME_TARGETS")
    if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "bridge_install_linux_desktop_application(): invalid arguments")
    endif()
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
        message(FATAL_ERROR "bridge_install_linux_desktop_application() requires Linux")
    endif()
    if(ARG_DESKTOP_INTEGRATION)
        set(_desktop_integration "${ARG_DESKTOP_INTEGRATION}")
    else()
        set(_desktop_integration "${BRIDGE_LINUX_DESKTOP_INTEGRATION}")
    endif()
    if(NOT "${_desktop_integration}" MATCHES "^(install|none)$")
        message(FATAL_ERROR "bridge_install_linux_desktop_application(): DESKTOP_INTEGRATION must be install or none")
    endif()
    foreach(_required IN ITEMS TARGET APPLICATION_ID APPLICATION_NAME ICON_DIRECTORY)
        if(NOT ARG_${_required})
            message(FATAL_ERROR "bridge_install_linux_desktop_application(): ${_required} is required")
        endif()
    endforeach()
    if(NOT TARGET "${ARG_TARGET}")
        message(FATAL_ERROR "bridge_install_linux_desktop_application(): target '${ARG_TARGET}' does not exist")
    endif()
    get_target_property(_type "${ARG_TARGET}" TYPE)
    if(NOT _type STREQUAL "EXECUTABLE")
        message(FATAL_ERROR "bridge_install_linux_desktop_application(): '${ARG_TARGET}' must be an executable")
    endif()
    if(NOT ARG_APPLICATION_ID MATCHES "^[A-Za-z][A-Za-z0-9_-]*([.][A-Za-z][A-Za-z0-9_-]*)+$")
        message(FATAL_ERROR "bridge_install_linux_desktop_application(): invalid APPLICATION_ID: ${ARG_APPLICATION_ID}")
    endif()
    if(ARG_APPLICATION_NAME MATCHES "[\r\n]")
        message(FATAL_ERROR "bridge_install_linux_desktop_application(): APPLICATION_NAME cannot contain newlines")
    endif()
    if(ARG_CATEGORIES AND NOT ARG_CATEGORIES MATCHES "^[A-Za-z0-9_-]+(;[A-Za-z0-9_-]+)*$")
        message(FATAL_ERROR "bridge_install_linux_desktop_application(): invalid CATEGORIES: ${ARG_CATEGORIES}")
    endif()
    set(_bundled_targets)
    foreach(_runtime_target IN LISTS ARG_RUNTIME_TARGETS)
        if(NOT TARGET "${_runtime_target}")
            message(FATAL_ERROR "bridge_install_linux_desktop_application(): runtime target '${_runtime_target}' does not exist")
        endif()
        get_target_property(_alias "${_runtime_target}" ALIASED_TARGET)
        if(_alias)
            set(_runtime_target "${_alias}")
        endif()
        list(APPEND _bundled_targets "${_runtime_target}")
    endforeach()
    foreach(_system_target IN LISTS ARG_SYSTEM_RUNTIME_TARGETS)
        if(NOT TARGET "${_system_target}")
            message(FATAL_ERROR "bridge_install_linux_desktop_application(): system runtime target '${_system_target}' does not exist")
        endif()
        get_target_property(_alias "${_system_target}" ALIASED_TARGET)
        if(_alias)
            set(_system_target "${_alias}")
        endif()
        if("${_system_target}" IN_LIST _bundled_targets)
            message(FATAL_ERROR
                "bridge_install_linux_desktop_application(): runtime target '${_system_target}' is both bundled and system-provided")
        endif()
    endforeach()
    _bridge_validate_icon_directory("${ARG_ICON_DIRECTORY}" _directory _python _dependencies)
    include(GNUInstallDirs)
    if(ARG_ASSET_DIRECTORY)
        set(_asset_directory "${ARG_ASSET_DIRECTORY}")
        cmake_path(ABSOLUTE_PATH _asset_directory BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" NORMALIZE)
        if(NOT IS_DIRECTORY "${_asset_directory}")
            message(FATAL_ERROR "bridge_install_linux_desktop_application(): ASSET_DIRECTORY does not exist: ${_asset_directory}")
        endif()
    endif()

    get_target_property(_output "${ARG_TARGET}" OUTPUT_NAME)
    if(NOT _output)
        set(_output "${ARG_TARGET}")
    endif()
    set(_desktop "${CMAKE_CURRENT_BINARY_DIR}/${ARG_APPLICATION_ID}.desktop")
    set(_categories "")
    if(ARG_CATEGORIES)
        set(_categories "Categories=${ARG_CATEGORIES};\n")
    endif()
    file(WRITE "${_desktop}"
        "[Desktop Entry]\nType=Application\nName=${ARG_APPLICATION_NAME}\n"
        "Exec=${_output}\nIcon=${ARG_APPLICATION_ID}\nTerminal=false\n${_categories}"
    )
    set(_component)
    if(ARG_COMPONENT)
        set(_component COMPONENT "${ARG_COMPONENT}")
    endif()
    set_property(TARGET "${ARG_TARGET}" APPEND PROPERTY INSTALL_RPATH "$ORIGIN/../${CMAKE_INSTALL_LIBDIR}")
    install(TARGETS "${ARG_TARGET}" RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}" ${_component})
    set(_seen_targets "${ARG_TARGET}")
    foreach(_runtime_target IN LISTS ARG_RUNTIME_TARGETS)
        if(NOT TARGET "${_runtime_target}")
            message(FATAL_ERROR "bridge_install_linux_desktop_application(): runtime target '${_runtime_target}' does not exist")
        endif()
        get_target_property(_alias "${_runtime_target}" ALIASED_TARGET)
        if(_alias)
            set(_target "${_alias}")
        else()
            set(_target "${_runtime_target}")
        endif()
        list(FIND _seen_targets "${_target}" _seen_index)
        if(NOT _seen_index EQUAL -1)
            message(FATAL_ERROR "bridge_install_linux_desktop_application(): duplicate runtime target '${_runtime_target}'")
        endif()
        list(APPEND _seen_targets "${_target}")
        get_target_property(_runtime_type "${_target}" TYPE)
        if(NOT _runtime_type STREQUAL "SHARED_LIBRARY")
            message(FATAL_ERROR "bridge_install_linux_desktop_application(): '${_runtime_target}' must be a shared library")
        endif()
        get_target_property(_imported "${_target}" IMPORTED)
        if(_imported)
            install(IMPORTED_RUNTIME_ARTIFACTS "${_target}" LIBRARY DESTINATION "${CMAKE_INSTALL_LIBDIR}" ${_component})
        else()
            set_property(TARGET "${_target}" APPEND PROPERTY INSTALL_RPATH "$ORIGIN")
            install(TARGETS "${_target}" LIBRARY DESTINATION "${CMAKE_INSTALL_LIBDIR}" ${_component})
        endif()
    endforeach()
    if(_asset_directory)
        install(DIRECTORY "${_asset_directory}/" DESTINATION "${CMAKE_INSTALL_BINDIR}" ${_component})
    endif()
    # SDL loads transparent PNGs directly from icons/ beside the executable.
    # Desktop integration reuses the same artwork under the application ID when requested.
    install(DIRECTORY "${_directory}/transparent/" DESTINATION "${CMAKE_INSTALL_BINDIR}/icons" ${_component})
    if(_desktop_integration STREQUAL "install")
        install(FILES "${_desktop}" DESTINATION share/applications ${_component})
        foreach(_size IN ITEMS 16 24 32 48 64 72 96 128 144 192 256 512)
            install(
                FILES "${_directory}/transparent/${_size}.png"
                DESTINATION "share/icons/hicolor/${_size}x${_size}/apps"
                RENAME "${ARG_APPLICATION_ID}.png"
                ${_component}
            )
        endforeach()
    endif()
endfunction()
