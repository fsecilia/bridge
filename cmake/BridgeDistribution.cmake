include_guard(GLOBAL)

# Writes a CMake recipe at configure time, keeping lists and paths out of shell argument parsing.
function(_bridge_distribution_recipe_value FILE KEY VALUE)
    if("${VALUE}" MATCHES "\\]==\\]")
        message(FATAL_ERROR "Bridge distribution recipe value contains an unsupported bracket delimiter: ${KEY}")
    endif()
    file(APPEND "${FILE}" "set(${KEY} [==[${VALUE}]==])\n")
endfunction()

# Registers a build-tree distribution target that hashes the explicitly named
# artifacts after their packaging targets finish. ARTIFACTS entries are
# <type>|<filename>, relative to OUTPUT_DIRECTORY.
function(bridge_add_distribution_target)
    cmake_parse_arguments(PARSE_ARGV 0 ARG "" "TARGET;OUTPUT_DIRECTORY;PLATFORM;VERSION" "ARTIFACTS;DEPENDS")
    if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES OR
       NOT ARG_TARGET OR NOT ARG_OUTPUT_DIRECTORY OR NOT ARG_PLATFORM OR NOT ARG_VERSION OR NOT ARG_ARTIFACTS)
        message(FATAL_ERROR "bridge_add_distribution_target requires TARGET, OUTPUT_DIRECTORY, PLATFORM, VERSION, and ARTIFACTS")
    endif()
    set(_recipe "${CMAKE_CURRENT_BINARY_DIR}/${ARG_TARGET}-distribution-recipe.cmake")
    file(WRITE "${_recipe}" "# Generated by BridgeDistribution.cmake\n")
    _bridge_distribution_recipe_value("${_recipe}" BRIDGE_DISTRIBUTION_DIRECTORY "${ARG_OUTPUT_DIRECTORY}")
    _bridge_distribution_recipe_value("${_recipe}" BRIDGE_DISTRIBUTION_PLATFORM "${ARG_PLATFORM}")
    _bridge_distribution_recipe_value("${_recipe}" BRIDGE_DISTRIBUTION_VERSION "${ARG_VERSION}")
    _bridge_distribution_recipe_value("${_recipe}" BRIDGE_DISTRIBUTION_ARTIFACTS "${ARG_ARTIFACTS}")
    add_custom_target("${ARG_TARGET}"
        COMMAND "${CMAKE_COMMAND}" "-DBRIDGE_DISTRIBUTION_RECIPE=${_recipe}"
            -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../scripts/bridge_distribution_manifest.cmake"
        DEPENDS ${ARG_DEPENDS}
        COMMENT "Recording verified distribution artifacts"
        VERBATIM
    )
endfunction()

# Registers a host-side coordinator. Each BUILD_TREES entry is
# <configured build directory>|<distribution target>. The coordinator invokes
# only those trees, then verifies and collects their manifests.
function(bridge_add_distribution_collection)
    cmake_parse_arguments(PARSE_ARGV 0 ARG "" "TARGET;OUTPUT_DIRECTORY;EXPECTED_SOURCE" "BUILD_TREES")
    if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES OR
       NOT ARG_TARGET OR NOT ARG_OUTPUT_DIRECTORY OR NOT ARG_EXPECTED_SOURCE OR NOT ARG_BUILD_TREES)
        message(FATAL_ERROR "bridge_add_distribution_collection requires TARGET, OUTPUT_DIRECTORY, EXPECTED_SOURCE, and BUILD_TREES")
    endif()
    if(CMAKE_CROSSCOMPILING)
        message(FATAL_ERROR "Bridge distribution collection must run from a host-native build tree")
    endif()
    set(_recipe "${CMAKE_CURRENT_BINARY_DIR}/${ARG_TARGET}-collection-recipe.cmake")
    file(WRITE "${_recipe}" "# Generated by BridgeDistribution.cmake\n")
    _bridge_distribution_recipe_value("${_recipe}" BRIDGE_DISTRIBUTION_COLLECTION_DIRECTORY "${ARG_OUTPUT_DIRECTORY}")
    _bridge_distribution_recipe_value("${_recipe}" BRIDGE_DISTRIBUTION_EXPECTED_SOURCE "${ARG_EXPECTED_SOURCE}")
    _bridge_distribution_recipe_value("${_recipe}" BRIDGE_DISTRIBUTION_COORDINATOR_DIRECTORY "${PROJECT_BINARY_DIR}")
    _bridge_distribution_recipe_value("${_recipe}" BRIDGE_DISTRIBUTION_BUILD_TREES "${ARG_BUILD_TREES}")
    add_custom_target("${ARG_TARGET}"
        COMMAND "${CMAKE_COMMAND}" "-DBRIDGE_DISTRIBUTION_RECIPE=${_recipe}"
            "-DBRIDGE_DISTRIBUTION_CONFIG=$<CONFIG>"
            -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../scripts/bridge_distribution_collect.cmake"
        COMMENT "Building and collecting requested distributions"
        VERBATIM
    )
endfunction()
